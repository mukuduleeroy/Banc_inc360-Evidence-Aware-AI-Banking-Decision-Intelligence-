# Export this variable in your shell; .env files are not loaded automatically.
# BANCINC_FEATURES_PATH=/absolute/path/to/customer_features.csv

# Real recommendations require a matching adjacent .manifest.json created by the builder
# or scripts/reconcile_phase2.py. Missing/mismatched provenance withholds offers.
# Presentation aliases use private outputs/.presentation_alias_key; preserve locally.

# Durable local audit (unverified demo reviewers; no bank authorization).
# BANCINC_AUDIT_DB=/absolute/private/path/review_audit.sqlite3
# Default: outputs/review_audit.sqlite3. Preserve DB and alias key; see Phase 4 schema docs.

# Phase 5 managed disposable demo: .venv/bin/python scripts/presentation.py start
# Its private configuration selects the DB generation; reset retains prior history.

# Phase 6 explicit portable data configuration (shell exports or Streamlit secrets).
# Local default preserves the validated competition workspace:
# DATA_MODE=LOCAL
# BANCINC_RUNTIME=LOCAL
# BANCINC_FEATURES_PATH=outputs/customer_features.csv
# Safe public deployment: DATA_MODE=DEMO and BANCINC_RUNTIME=CLOUD.
# Approved deployment configuration: see .streamlit/secrets.example.toml and Phase 6 guide.
# Never commit real .streamlit/secrets.toml or private_data/.
